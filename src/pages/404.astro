---
import Layout from '../layouts/Layout.astro';
import { portfolioData } from '../data/portfolio';
---

<Layout title={`Page Not Found — ${portfolioData.name}`}>
  <main class="flex-1 flex flex-col items-center justify-center text-center py-24">
    <span class="text-[#86efac] font-mono text-sm uppercase tracking-widest mb-2">404 Error</span>
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-[#faf5e8] mb-4">
      Page not found
    </h1>
    <p class="text-[#ded7c5] text-sm sm:text-base max-w-md mb-8">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="px-5 py-2.5 rounded-xl bg-[#f5efe0] text-[#07170f] font-semibold text-sm hover:bg-[#fffcf4] transition-all shadow-lg shadow-emerald-950/30"
    >
      ← Return to Home
    </a>
  </main>
</Layout>
