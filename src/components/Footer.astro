---
import { portfolioData } from '../data/portfolio';

const currentYear = new Date().getFullYear();
---

<footer class="pt-8 pb-12 border-t border-[#14281e] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#8e8975]">
  <p>© {currentYear} {portfolioData.name}. All rights reserved.</p>
  <p class="flex items-center gap-1.5">
    Built with
    <a
      href="https://astro.build"
      target="_blank"
      rel="noopener noreferrer"
      class="text-[#ded7c5] hover:text-[#faf5e8] transition-colors underline underline-offset-4 decoration-[#224835]"
    >
      Astro
    </a>
    &
    <a
      href="https://tailwindcss.com"
      target="_blank"
      rel="noopener noreferrer"
      class="text-[#ded7c5] hover:text-[#faf5e8] transition-colors underline underline-offset-4 decoration-[#224835]"
    >
      Tailwind CSS
    </a>
  </p>
</footer>
