---
import { portfolioData } from '../data/portfolio';
---

<section id="about" class="mb-16 scroll-mt-24">
  <div class="space-y-5">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-[#0c2217] border border-[#1b3d2c] text-[#ded7c5]">
      <svg class="w-3.5 h-3.5 text-[#86efac]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      {portfolioData.location}
    </div>

    <div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-[#faf5e8]">
        Hi, I'm <span class="bg-gradient-to-r from-[#faf5e8] via-[#ede5d0] to-[#c7bfa9] bg-clip-text text-transparent">{portfolioData.name}</span>
      </h1>
      <p class="text-lg sm:text-2xl font-semibold text-[#86efac] mt-2">
        {portfolioData.title}
      </p>
    </div>

    <p class="text-base sm:text-lg text-[#ded7c5] leading-relaxed max-w-2xl">
      {portfolioData.about}
    </p>

    <!-- Action buttons and socials with clean wrapping -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
      <div class="flex flex-wrap items-center gap-2.5">
        <a
          href="#contact"
          class="inline-flex items-center justify-center h-10 px-4 rounded-xl bg-[#f5efe0] text-[#07170f] font-semibold text-sm hover:bg-[#fffcf4] hover:shadow-lg hover:shadow-emerald-950/40 transition-all duration-200"
        >
          Get in touch
        </a>
        <a
          href={portfolioData.resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-xl bg-[#0d2319] text-[#ded7c5] font-medium text-sm border border-[#1f4533] hover:bg-[#143325] hover:text-[#faf5e8] transition-all duration-200"
        >
          <svg class="w-4 h-4 text-[#86efac] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Download Resume</span>
        </a>
        <a
          href="#projects"
          class="inline-flex items-center justify-center h-10 px-4 rounded-xl bg-[#091a13]/70 text-[#c5bfae] font-medium text-sm border border-[#173829] hover:bg-[#122e21] hover:text-[#faf5e8] transition-all duration-200"
        >
          View Projects
        </a>
      </div>

      <div class="flex items-center gap-2 pt-1 sm:pt-0">
        {portfolioData.socials.linkedin && (
          <a
            href={portfolioData.socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center h-10 w-10 rounded-xl bg-[#0c2217]/90 text-[#c5bfae] hover:text-[#faf5e8] border border-[#1b3d2c] hover:bg-[#143325] transition-all"
            aria-label="LinkedIn Profile"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
        )}
        {portfolioData.socials.github && (
          <a
            href={portfolioData.socials.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center h-10 w-10 rounded-xl bg-[#0c2217]/90 text-[#c5bfae] hover:text-[#faf5e8] border border-[#1b3d2c] hover:bg-[#143325] transition-all"
            aria-label="GitHub Profile"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
</section>
