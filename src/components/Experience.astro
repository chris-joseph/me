---
import { portfolioData } from '../data/portfolio';
---

<section id="experience" class="mb-16 scroll-mt-24">
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-2xl font-bold tracking-tight text-zinc-100 flex items-center gap-2">
      <span class="text-cyan-400 font-mono text-base">02.</span> Work Experience
    </h2>
    <span class="text-xs text-zinc-500 font-mono">
      6+ Years Experience
    </span>
  </div>

  <div class="space-y-10 border-l border-zinc-800/80 ml-3 pl-6 relative">
    {
      portfolioData.experience.map((exp) => (
        <div class="relative group">
          <!-- Main timeline bullet: w-2.5 (10px), perfectly centered on border-l with pl-6 (24px) -->
          <span class="absolute -left-[29px] top-1.5 h-2.5 w-2.5 rounded-full bg-zinc-700 border-2 border-zinc-950 group-hover:bg-cyan-400 transition-colors" />

          {/* If entry has grouped sub-roles (e.g. Thoughtworks) */}
          {exp.roles && exp.roles.length > 0 ? (
            <div>
              {/* Company Header */}
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-4">
                <h3 class="text-lg font-bold text-zinc-100">
                  {exp.companyUrl ? (
                    <a
                      href={exp.companyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-zinc-100 hover:text-cyan-400 transition-colors inline-flex items-center gap-1.5 underline underline-offset-4 decoration-zinc-700 hover:decoration-cyan-400"
                    >
                      {exp.company}
                      <svg class="w-3.5 h-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  ) : (
                    <span>{exp.company}</span>
                  )}
                </h3>
                <span class="text-xs font-mono text-zinc-500 whitespace-nowrap">
                  {exp.period}
                </span>
              </div>

              {/* Nested Sub-roles Timeline */}
              <div class="space-y-6 border-l border-zinc-800/60 ml-1.5 pl-4">
                {exp.roles.map((role) => (
                  <div class="relative">
                    <!-- Sub timeline bullet: w-1.5 (6px), perfectly centered on border-l with pl-4 (16px) -->
                    <span class="absolute -left-[19px] top-2 h-1.5 w-1.5 rounded-full bg-zinc-600 group-hover:bg-cyan-400/70 transition-colors" />

                    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-1.5">
                      <div class="flex flex-wrap items-center gap-2">
                        <h4 class="text-sm font-semibold text-zinc-200">
                          {role.role}
                        </h4>
                        {role.employmentType && (
                          <span class={`text-[11px] font-mono px-2 py-0.5 rounded-md border ${
                            role.employmentType.includes('Full-time')
                              ? 'bg-emerald-950/50 text-emerald-300 border-emerald-800/50'
                              : 'bg-zinc-800/70 text-zinc-400 border-zinc-700/50'
                          }`}>
                            {role.employmentType}
                          </span>
                        )}
                      </div>
                      <span class="text-xs font-mono text-zinc-500 whitespace-nowrap">
                        {role.period}
                      </span>
                    </div>

                    {role.description && (
                      <p class="text-sm text-zinc-400 leading-relaxed mb-2.5">
                        {role.description}
                      </p>
                    )}

                    {role.highlights && role.highlights.length > 0 && (
                      <ul class="space-y-1.5 text-xs text-zinc-400 list-disc list-outside pl-4">
                        {role.highlights.map((item) => (
                          <li class="leading-relaxed marker:text-zinc-600">{item}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                ))}
              </div>
            </div>
          ) : (
            /* Standard single-role entry */
            <div>
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-1.5">
                <h3 class="text-base font-semibold text-zinc-100">
                  {exp.role} <span class="text-zinc-500 font-normal">at</span>{' '}
                  {exp.companyUrl ? (
                    <a
                      href={exp.companyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-zinc-200 hover:text-cyan-400 transition-colors inline-flex items-center gap-1 underline underline-offset-4 decoration-zinc-700 hover:decoration-cyan-400"
                    >
                      {exp.company}
                      <svg class="w-3 h-3 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  ) : (
                    <span class="text-zinc-300">{exp.company}</span>
                  )}
                </h3>
                <span class="text-xs font-mono text-zinc-500 whitespace-nowrap">
                  {exp.period}
                </span>
              </div>

              {exp.description && (
                <p class="text-sm text-zinc-400 leading-relaxed mb-3">
                  {exp.description}
                </p>
              )}

              {exp.highlights && exp.highlights.length > 0 && (
                <ul class="space-y-2 text-xs text-zinc-400 list-disc list-outside pl-4">
                  {exp.highlights.map((item) => (
                    <li class="leading-relaxed marker:text-zinc-600">{item}</li>
                  ))}
                </ul>
              )}
            </div>
          )}
        </div>
      ))
    }
  </div>
</section>
