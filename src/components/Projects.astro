---
import { portfolioData } from '../data/portfolio';
---

<section id="projects" class="mb-16 scroll-mt-24">
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-2xl font-bold tracking-tight text-zinc-100 flex items-center gap-2">
      <span class="text-cyan-400 font-mono text-base">01.</span> Featured Projects
    </h2>
    <span class="text-xs text-zinc-500 font-mono">
      {portfolioData.projects.length} Total
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {
      portfolioData.projects.map((project, index) => {
        // First project spans full width for a balanced 1 + 4 grid
        const isLead = index === 0;
        return (
          <div
            class={`group relative flex flex-col justify-between p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700 hover:bg-zinc-900/70 transition-all duration-200 ${
              isLead ? 'md:col-span-2 md:p-6 bg-gradient-to-b from-zinc-900/60 to-zinc-900/30' : ''
            }`}
          >
            <div>
              <div class="flex items-start justify-between gap-2 mb-2">
                <h3 class={`font-semibold text-zinc-100 group-hover:text-cyan-300 transition-colors ${
                  isLead ? 'text-xl' : 'text-lg'
                }`}>
                  {project.link ? (
                    <a
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 hover:underline decoration-zinc-600 underline-offset-4"
                    >
                      {project.title}
                      <svg class="w-3.5 h-3.5 text-zinc-500 group-hover:text-cyan-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  ) : (
                    project.title
                  )}
                </h3>
                <div class="flex items-center gap-2 text-zinc-400">
                  {project.github && (
                    <a
                      href={project.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="p-1 hover:text-zinc-100 transition-colors"
                      aria-label={`${project.title} GitHub repository`}
                    >
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                      </svg>
                    </a>
                  )}
                  {project.link && (
                    <a
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="p-1 hover:text-cyan-300 transition-colors"
                      aria-label={`${project.title} live link`}
                    >
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  )}
                </div>
              </div>

              <p class={`text-sm text-zinc-400 leading-relaxed mb-4 ${
                isLead ? 'max-w-2xl' : ''
              }`}>
                {project.description}
              </p>
            </div>

            <div class="flex flex-wrap gap-1.5 pt-2">
              {project.tags.map((tag) => (
                <span class="px-2 py-0.5 rounded-md text-xs font-mono bg-zinc-800/80 text-zinc-300 border border-zinc-700/50">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        );
      })
    }
  </div>
</section>
