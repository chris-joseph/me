---
import { portfolioData } from '../data/portfolio';
---

<section id="contact" class="mb-16 scroll-mt-24">
  <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-b from-[var(--contact-bg-from)] to-[var(--contact-bg-to)] border border-[var(--border-card)] text-center relative overflow-hidden transition-all duration-300">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-[var(--contact-glow)] via-transparent to-transparent"></div>

    <span class="text-[var(--accent)] font-mono text-xs uppercase tracking-widest">05. What's Next?</span>
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-primary)] mt-2 mb-3 transition-colors">
      Let's work together.
    </h2>
    <p class="text-[var(--text-secondary)] text-sm sm:text-base max-w-lg mx-auto mb-8 leading-relaxed transition-colors">
      Whether you're looking to build an offline-first mobile app, need technical leadership for your Flutter architecture, or want to explore AI-driven SDLC workflows, I'd love to connect.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3">
      {portfolioData.socials.email && (
        <a
          href={`mailto:${portfolioData.socials.email}`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[var(--btn-primary-bg)] text-[var(--btn-primary-text)] font-semibold text-sm hover:bg-[var(--btn-primary-hover)] hover:scale-[1.02] active:scale-[0.98] transition-all duration-150 shadow-lg shadow-emerald-950/20"
        >
          <svg class="w-4 h-4 text-[var(--btn-primary-text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Say Hello ({portfolioData.socials.email})
        </a>
      )}

      {portfolioData.socials.phone && (
        <a
          href={`tel:${portfolioData.socials.phone}`}
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-[var(--btn-secondary-bg)] text-[var(--btn-secondary-text)] font-medium text-sm border border-[var(--btn-secondary-border)] hover:bg-[var(--btn-secondary-hover)] transition-all"
        >
          <svg class="w-4 h-4 text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {portfolioData.socials.phone}
        </a>
      )}
    </div>
  </div>
</section>
