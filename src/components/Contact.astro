---
import { portfolioData } from '../data/portfolio';
---

<section id="contact" class="mb-16 scroll-mt-24">
  <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-b from-[#0e241b]/90 to-[#07160f] border border-[#1b3d2c]/80 text-center relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-[#1d4d38]/30 via-transparent to-transparent"></div>

    <span class="text-[#86efac] font-mono text-xs uppercase tracking-widest">05. What's Next?</span>
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#faf5e8] mt-2 mb-3">
      Let's work together.
    </h2>
    <p class="text-[#ded7c5] text-sm sm:text-base max-w-lg mx-auto mb-8 leading-relaxed">
      Whether you're looking to build an offline-first mobile app, need technical leadership for your Flutter architecture, or want to explore AI-driven SDLC workflows, I'd love to connect.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3">
      {portfolioData.socials.email && (
        <a
          href={`mailto:${portfolioData.socials.email}`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#f5efe0] text-[#07170f] font-semibold text-sm hover:bg-[#fffcf4] hover:scale-[1.02] active:scale-[0.98] transition-all duration-150 shadow-lg shadow-emerald-950/40"
        >
          <svg class="w-4 h-4 text-[#07170f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Say Hello ({portfolioData.socials.email})
        </a>
      )}

      {portfolioData.socials.phone && (
        <a
          href={`tel:${portfolioData.socials.phone}`}
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-[#0d2319] text-[#ded7c5] font-medium text-sm border border-[#1f4533] hover:bg-[#143325] hover:text-[#faf5e8] transition-all"
        >
          <svg class="w-4 h-4 text-[#86efac]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {portfolioData.socials.phone}
        </a>
      )}
    </div>
  </div>
</section>
