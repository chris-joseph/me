---
import { portfolioData } from '../data/portfolio';
---

<section id="skills" class="mb-16 scroll-mt-24">
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-2xl font-bold tracking-tight text-[var(--text-primary)] flex items-center gap-2 transition-colors">
      <span class="text-[var(--accent)] font-mono text-base">03.</span> Skills & Technologies
    </h2>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {
      portfolioData.skills.map((skillGroup) => (
        <div class="p-5 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-card)] flex flex-col justify-between hover:border-[var(--border-card-hover)] hover:bg-[var(--bg-card-hover)] transition-all">
          <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-3">
            {skillGroup.category}
          </h3>
          <div class="flex flex-wrap gap-1.5">
            {skillGroup.items.map((skill) => (
              <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-[var(--tag-bg)] text-[var(--tag-text)] border border-[var(--tag-border)] hover:border-[var(--border-card-hover)] hover:text-[var(--text-primary)] transition-colors">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
