---
import { portfolioData } from '../data/portfolio';
---

<section id="skills" class="mb-16 scroll-mt-24">
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-2xl font-bold tracking-tight text-zinc-100 flex items-center gap-2">
      <span class="text-cyan-400 font-mono text-base">03.</span> Skills & Technologies
    </h2>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {
      portfolioData.skills.map((skillGroup) => (
        <div class="p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 flex flex-col justify-between hover:border-zinc-700/80 transition-colors">
          <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-400 mb-3">
            {skillGroup.category}
          </h3>
          <div class="flex flex-wrap gap-1.5">
            {skillGroup.items.map((skill) => (
              <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-zinc-800/60 text-zinc-300 border border-zinc-700/40 hover:border-zinc-500 hover:text-white transition-colors">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
