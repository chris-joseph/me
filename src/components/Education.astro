---
import { portfolioData } from '../data/portfolio';
---

<section id="education" class="mb-16 scroll-mt-24">
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-2xl font-bold tracking-tight text-[#faf5e8] flex items-center gap-2">
      <span class="text-[#86efac] font-mono text-base">04.</span> Education & Languages
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-stretch">
    <!-- Education Card -->
    <div class="p-5 rounded-2xl bg-[#0d2218]/65 border border-[#1b3d2c]/80 flex flex-col justify-between hover:border-[#356a50] transition-colors h-full">
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-mono uppercase tracking-wider text-[#8e8975]">Degree</span>
          <span class="text-xs font-mono text-[#8e8975] bg-[#132d20]/80 px-2 py-0.5 rounded border border-[#224835]">
            {portfolioData.education[0].period}
          </span>
        </div>
        <h3 class="text-base font-semibold text-[#faf5e8] mb-1.5">
          {portfolioData.education[0].degree}
        </h3>
        <p class="text-sm text-[#ded7c5]">
          {portfolioData.education[0].institution}
        </p>
      </div>

      <div class="pt-4 mt-4 border-t border-[#183627]/70 flex items-center gap-2 text-xs text-[#8e8975] font-mono">
        <svg class="w-4 h-4 text-[#86efac]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
        </svg>
        <span>Full-time Engineering Program</span>
      </div>
    </div>

    <!-- Languages Card -->
    <div class="p-5 rounded-2xl bg-[#0d2218]/65 border border-[#1b3d2c]/80 flex flex-col justify-between hover:border-[#356a50] transition-colors h-full">
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-mono uppercase tracking-wider text-[#8e8975]">Communication</span>
          <span class="text-xs font-mono text-[#8e8975]">
            {portfolioData.languages.length} Languages
          </span>
        </div>
        <div class="space-y-2.5">
          {
            portfolioData.languages.map((lang) => {
              const [name, proficiency] = lang.split(' (');
              const cleanProficiency = proficiency ? proficiency.replace(')', '') : '';
              return (
                <div class="flex items-center justify-between text-sm py-0.5">
                  <span class="text-[#faf5e8] font-medium">{name}</span>
                  <span class="text-xs font-mono text-[#ded7c5] bg-[#132d20]/80 px-2 py-0.5 rounded border border-[#224835]">
                    {cleanProficiency}
                  </span>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</section>
