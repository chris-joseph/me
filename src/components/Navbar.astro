---
import { portfolioData } from '../data/portfolio';

const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#experience', label: 'Experience' },
  { href: '#skills', label: 'Skills' },
  { href: '#education', label: 'Education' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-4 z-50 mb-12 flex items-center justify-center">
  <!-- Centered Floating Navigation Bar -->
  <nav class="relative flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[var(--bg-nav)] backdrop-blur-md border border-[var(--border-nav)] shadow-lg shadow-black/10 dark:shadow-black/40 transition-colors duration-300">
    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center gap-0.5 text-xs lg:text-sm font-medium text-[var(--nav-link)]">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="px-3 py-1 rounded-full hover:text-[var(--nav-link-hover)] hover:bg-[var(--nav-link-hover-bg)] transition-all"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={portfolioData.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-2 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[var(--accent)] bg-[var(--accent-bg)] hover:opacity-90 border border-[var(--accent-border)] text-xs font-semibold tracking-wide transition-all shadow-sm"
      >
        <span>CV</span>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
      <div class="h-4 w-[1px] bg-[var(--border-nav)] mx-1.5"></div>
      <button
        class="theme-toggle-btn p-1.5 rounded-full text-[var(--nav-link)] hover:text-[var(--nav-link-hover)] hover:bg-[var(--nav-link-hover-bg)] transition-all focus:outline-none"
        aria-label="Toggle bright / dark theme"
        title="Toggle bright / dark theme"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg class="theme-icon-sun w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="theme-icon-moon w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>

    <!-- Mobile Nav Controls -->
    <div class="flex items-center gap-1.5 md:hidden">
      <a
        href={portfolioData.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[var(--accent)] bg-[var(--accent-bg)] hover:opacity-90 border border-[var(--accent-border)] text-xs font-semibold transition-all"
      >
        <span>CV</span>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
      <button
        class="theme-toggle-btn p-1.5 rounded-full text-[var(--nav-link)] hover:text-[var(--nav-link-hover)] hover:bg-[var(--nav-link-hover-bg)] transition-all focus:outline-none"
        aria-label="Toggle bright / dark theme"
        title="Toggle bright / dark theme"
      >
        <svg class="theme-icon-sun w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="theme-icon-moon w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
      <button
        id="mobile-menu-btn"
        class="p-1 rounded-full text-[var(--nav-link)] hover:text-[var(--nav-link-hover)] hover:bg-[var(--nav-link-hover-bg)] transition-colors focus:outline-none"
        aria-label="Toggle Navigation Menu"
      >
        <svg id="menu-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div
      id="mobile-menu"
      class="hidden absolute top-full left-1/2 -translate-x-1/2 mt-3 w-52 p-2 rounded-2xl bg-[var(--bg-nav)] backdrop-blur-lg border border-[var(--border-nav)] shadow-2xl flex flex-col gap-1 md:hidden z-50 transition-colors duration-300"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link px-3 py-2 rounded-xl text-sm font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--nav-link-hover-bg)] transition-all"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  // Mobile menu handling
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  const links = document.querySelectorAll('.mobile-nav-link');

  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    if (isHidden) {
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    } else {
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    }
  });

  links.forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });

  // Theme toggle handling
  const themeToggleBtns = document.querySelectorAll('.theme-toggle-btn');
  const sunIcons = document.querySelectorAll('.theme-icon-sun');
  const moonIcons = document.querySelectorAll('.theme-icon-moon');

  function updateThemeUI(isDark: boolean) {
    sunIcons.forEach((icon) => {
      if (isDark) {
        icon.classList.remove('hidden');
      } else {
        icon.classList.add('hidden');
      }
    });
    moonIcons.forEach((icon) => {
      if (isDark) {
        icon.classList.add('hidden');
      } else {
        icon.classList.remove('hidden');
      }
    });
  }

  // Initialize icons state
  const isInitialDark = document.documentElement.classList.contains('dark');
  updateThemeUI(isInitialDark);

  // Bind click handlers to all toggle buttons (desktop and mobile)
  themeToggleBtns.forEach((toggleBtn) => {
    toggleBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateThemeUI(isDark);
    });
  });
</script>
